<section class="page-head">
  <h1>Quản lý Sách</h1>
  {{#if isWriter}}
  <p class="routing">
    Đang dùng tài khoản ghi <code>{{writeUser}}</code> (Thủ Thư): thêm sách, sửa giá, đổi tên, sửa tác giả.
  </p>
  {{else}}
  <p class="routing">
    Đang dùng tài khoản đọc <code>{{readUser}}</code>: Chỉ xem danh sách, giá và giá sau thuế.
  </p>
  {{/if}}
</section>

<section class="stats" aria-label="Tổng quan">
  <div class="card stat"><small>Tổng số sách</small><strong>{{totalBooks}}</strong></div>
  <div class="card stat"><small>VAT áp dụng</small><strong>{{vat}}%</strong></div>
  <div class="card stat"><small>Tài khoản đang dùng</small><strong class="text">{{#if isWriter}}Writer · Thủ Thư{{else}}Reader · Chỉ xem{{/if}}</strong></div>
  <div class="card stat"><small>Lượt truy cập (session)</small><strong>{{views}}</strong></div>
</section>

{{#if flash}}
<p class="card flash" role="status">
  <span class="tick" aria-hidden="true">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#1d2330" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>
  </span>
  {{flash}}
</p>
{{/if}}

<div class="workspace {{#if isWriter}}with-side{{/if}}">
  <section class="card panel">
    <div class="panel-head">
      <h2>Danh sách sách</h2>
      <span class="chip">{{books.length}} sách</span>
    </div>
    <form method="GET" action="/" class="search">
      <span class="search-label">Tìm theo mã sách</span>
      {{> codeInput value=searchCode}}
      <button type="submit" class="btn sky small">Tìm</button>
      {{#if searchCode}}<a href="/">Xem tất cả</a>{{/if}}
    </form>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Mã</th><th>Tên sách</th><th>Tác giả</th>
            <th class="num">Giá gốc</th><th class="num">VAT (%)</th><th class="num">Giá sau VAT</th>
            {{#if isWriter}}<th></th>{{/if}}
          </tr>
        </thead>
        <tbody>
          {{#each books}}
          <tr>
            <td><span class="chip">{{code}}</span></td>
            {{#if @root.isWriter}}
            <td class="title"><input form="edit-{{code}}" name="title" value="{{title}}" aria-label="Tên sách" required></td>
            <td><input form="edit-{{code}}" name="author" value="{{author}}" aria-label="Tác giả" required></td>
            <td class="num"><input form="edit-{{code}}" name="price" type="number" min="0" step="any" value="{{price}}" aria-label="Giá gốc" required></td>
            {{else}}
            <td class="title">{{title}}</td>
            <td>{{author}}</td>
            <td class="num">{{price}}</td>
            {{/if}}
            <td class="num">{{vat}}</td>
            <td class="num"><span class="total">{{priceAfterVat}}</span></td>
            {{#if @root.isWriter}}
            <td class="num">
              <form id="edit-{{code}}" method="POST" action="/books/{{code}}"><button type="submit" class="btn mint small">Lưu</button></form>
            </td>
            {{/if}}
          </tr>
          {{else}}
          <tr><td class="empty" colspan="{{#if isWriter}}7{{else}}6{{/if}}">{{#if searchCode}}Không tìm thấy sách có mã "{{searchCode}}".{{else}}Chưa có sách nào.{{/if}}</td></tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </section>

  {{#if isWriter}}
  <aside class="card panel side">
    <div class="panel-head"><h2>Thêm sách mới</h2></div>
    <form method="POST" action="/" class="add">
      <label class="field">Mã sản phẩm <small>3 số cuối MSSV ({{codePrefix}}), dấu gạch tự thêm, rồi số thứ tự</small>
        {{> codeInput}}
      </label>
      <label class="field">Tên sách
        <input name="title" required>
      </label>
      <label class="field">Tác giả
        <input name="author" required>
      </label>
      <label class="field">Giá gốc
        <input name="price" type="number" min="0" step="any" required>
      </label>
      <button type="submit" class="btn sky">Thêm sách</button>
    </form>
  </aside>
  {{/if}}
</div>

<script>
  document.querySelectorAll('[data-code-field]').forEach((field) => {
    const input = field.querySelector('input');
    const status = field.querySelector('.code-status');
    const hint = field.querySelector('.code-hint');
    const submit = input.form.querySelector('[type="submit"]');
    const prefix = input.dataset.prefix;

    // The check starts once the 3-digit prefix is in; typing is never blocked,
    // only submitting is, until the code reads "<prefix>-<sequence number>".
    const refresh = () => {
      const hasPrefix = input.value.length >= 3;
      const prefixOk = input.value.slice(0, 3) === prefix;
      const complete = prefixOk && /^\d{3}-\d+$/.test(input.value);

      status.hidden = !hasPrefix;
      hint.hidden = !hasPrefix || prefixOk;
      if (hasPrefix) {
        const tip = !prefixOk
          ? `Không hợp lệ: đầu mã phải là ${prefix}`
          : complete ? 'Hợp lệ' : 'Hợp lệ, hãy nhập tiếp số thứ tự';
        status.dataset.state = prefixOk ? 'ok' : 'bad';
        status.textContent = prefixOk ? '✓' : '✕';
        status.dataset.tip = tip;
        status.setAttribute('aria-label', tip);
      }
      submit.disabled = !complete;
    };

    // Keeps only digits and inserts the hyphen after the third one.
    input.addEventListener('input', (event) => {
      const digits = input.value.replace(/\D/g, '');
      // While deleting, don't re-add a trailing hyphen or it could never be erased.
      const deleting = (event.inputType || '').startsWith('delete');
      const needsHyphen = digits.length > 3 || (digits.length === 3 && !deleting);
      input.value = needsHyphen ? `${digits.slice(0, 3)}-${digits.slice(3)}` : digits;
      refresh();
    });

    refresh();
  });
</script>
