<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Quản lý Sách</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Lato:wght@400;700;900&family=Libre+Baskerville:wght@400;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --ink: #1d2330;
      --muted: #747a8a;
      --bg: #f6f5fa;
      --card: #ffffff;
      --mint: #d9f1dd;
      --mint-strong: #86e3b4;
      --pink: #fbd3dc;
      --peach: #fde2c6;
      --lavender: #c8c3ee;
      --sky: #d6effb;
      --blush: #fbf1f1;
      --orange: #f07427;
      --line: 1.5px solid var(--ink);
      --radius: 16px;
      --sans: 'Lato', system-ui, -apple-system, 'Segoe UI', sans-serif;
      --serif: 'Libre Baskerville', Georgia, 'Times New Roman', serif;
    }

    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: var(--sans);
      color: var(--ink);
      background:
        radial-gradient(circle at 0% 100%, #dff5ee 0, transparent 28rem),
        radial-gradient(circle at 100% 0%, #fdebd9 0, transparent 30rem),
        var(--bg);
      background-attachment: fixed;
      min-height: 100vh;
      line-height: 1.5;
    }
    .shell { max-width: 1200px; margin: 0 auto; padding: 2rem 1.5rem 3rem; display: grid; gap: 1.75rem; }
    a { color: var(--ink); font-weight: 700; text-underline-offset: 3px; }
    code {
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: .85em;
      background: var(--card);
      border: 1px solid var(--ink);
      border-radius: 6px;
      padding: .05rem .35rem;
    }
    h1, h2, h3, p { margin: 0; }
    h1 { font-family: var(--serif); font-size: 2rem; line-height: 1.25; }
    h2 { font-size: 1.05rem; font-weight: 900; }

    /* Outlined card with a hard, outlined offset layer behind it */
    .card {
      --shadow: var(--lavender);
      background: var(--card);
      border: var(--line);
      border-radius: var(--radius);
      box-shadow: 5px 5px 0 -1.5px var(--shadow), 5px 5px 0 0 var(--ink);
    }

    .btn {
      --shadow: var(--ink);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: .45rem;
      font: 700 .9rem var(--sans);
      color: var(--ink);
      background: var(--pink);
      border: var(--line);
      border-radius: 10px;
      padding: .55rem 1rem;
      cursor: pointer;
      box-shadow: 2px 2px 0 var(--shadow);
      transition: transform .08s ease, box-shadow .08s ease;
    }
    .btn:hover { transform: translate(-1px, -1px); box-shadow: 3px 3px 0 var(--shadow); }
    .btn:active { transform: translate(2px, 2px); box-shadow: 0 0 0 var(--shadow); }
    .btn.mint { background: var(--mint-strong); }
    .btn.sky { background: var(--sky); }
    .btn.small { padding: .35rem .8rem; font-size: .85rem; }
    .btn:focus-visible, input:focus-visible, a:focus-visible {
      outline: 3px solid var(--orange);
      outline-offset: 2px;
    }

    .chip {
      display: inline-flex;
      align-items: center;
      gap: .35rem;
      font-size: .8rem;
      font-weight: 700;
      background: var(--card);
      border: var(--line);
      border-radius: 8px;
      padding: .2rem .6rem;
      white-space: nowrap;
      text-decoration: none;
    }

    input {
      width: 100%;
      font: 400 .95rem var(--sans);
      color: var(--ink);
      background: var(--card);
      border: var(--line);
      border-radius: 10px;
      padding: .6rem .8rem;
    }
    input::placeholder { color: #a3a7b3; }

    /* Top navigation */
    .topbar { background: var(--card); border-bottom: var(--line); position: sticky; top: 0; z-index: 10; }
    .topbar-inner {
      max-width: 1200px; margin: 0 auto; padding: .7rem 1.5rem;
      display: flex; align-items: center; gap: 1.5rem; flex-wrap: wrap;
    }
    .brand { display: flex; align-items: center; gap: .65rem; text-decoration: none; font-family: var(--serif); font-size: 1.1rem; }
    .brand-mark {
      width: 38px; height: 38px;
      display: grid; place-items: center;
      background: var(--orange);
      border: var(--line);
      border-radius: 10px;
      box-shadow: 2px 2px 0 var(--ink);
    }
    .nav { display: flex; gap: .4rem; margin-right: auto; }
    .nav a { padding: .4rem .8rem; border: 1.5px solid transparent; border-radius: 10px; text-decoration: none; font-size: .92rem; }
    .nav a:hover { background: #ecebf3; }
    .nav a[aria-current="page"] { background: var(--peach); border-color: var(--ink); box-shadow: 2px 2px 0 var(--ink); }

    .account {
      display: flex;
      gap: .3rem;
      padding: .25rem;
      background: #ecebf3;
      border: var(--line);
      border-radius: 12px;
    }
    .account button {
      font: 700 .85rem var(--sans);
      color: var(--ink);
      background: transparent;
      border: 1.5px solid transparent;
      border-radius: 9px;
      padding: .3rem .75rem;
      cursor: pointer;
      text-align: left;
      line-height: 1.25;
    }
    .account button small { display: block; font-weight: 400; font-size: .72rem; color: var(--muted); }
    .account button:hover { background: var(--card); }
    .account button[aria-pressed="true"] { background: var(--mint-strong); border-color: var(--ink); box-shadow: 2px 2px 0 var(--ink); }
    .account button[aria-pressed="true"] small { color: var(--ink); }

    /* Page header + stats */
    .page-head { display: grid; gap: .5rem; }
    .page-head .routing { color: #4b5162; max-width: 75ch; }
    .stats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.25rem; }
    .stat { padding: 1rem 1.15rem; display: grid; gap: .15rem; }
    .stat:nth-child(1) { background: var(--mint); }
    .stat:nth-child(2) { --shadow: var(--peach); }
    .stat:nth-child(3) { --shadow: var(--mint-strong); }
    .stat:nth-child(4) { --shadow: var(--pink); }
    .stat small { color: var(--muted); font-size: .8rem; font-weight: 700; }
    .stat:nth-child(1) small { color: #4b5162; }
    .stat strong { font-size: 1.6rem; font-weight: 900; line-height: 1.2; overflow-wrap: anywhere; }
    .stat strong.text { font-size: 1.15rem; padding: .3rem 0; }

    .flash {
      --shadow: var(--mint-strong);
      display: flex;
      align-items: center;
      gap: .75rem;
      padding: .8rem 1rem;
      font-weight: 700;
    }
    .flash .tick {
      flex: none;
      width: 26px; height: 26px;
      display: grid; place-items: center;
      background: var(--mint-strong);
      border: var(--line);
      border-radius: 50%;
    }

    /* Workspace: table + side form */
    .workspace { display: grid; gap: 1.75rem; align-items: start; }
    .workspace.with-side { grid-template-columns: minmax(0, 1fr) 300px; }
    .panel { overflow: hidden; }
    .panel.side { --shadow: var(--peach); position: sticky; top: 5.5rem; }
    .panel-head {
      display: flex; align-items: center; justify-content: space-between; gap: 1rem;
      padding: .8rem 1.25rem;
      background: #eeeff6;
      border-bottom: var(--line);
    }
    form.add { display: grid; gap: .85rem; padding: 1.25rem; }
    .field { display: grid; gap: .25rem; font-size: .78rem; font-weight: 700; color: #4b5162; }
    .field small { font-weight: 400; color: var(--muted); }

    .table-wrap { overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; font-size: .93rem; }
    th, td { padding: .7rem .7rem; text-align: left; vertical-align: middle; }
    th { font-size: .75rem; text-transform: uppercase; letter-spacing: .04em; color: var(--muted); white-space: nowrap; border-bottom: var(--line); }
    tbody tr + tr td { border-top: 1.5px dashed #b9bcc8; }
    tbody tr:hover { background: var(--blush); }
    .num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
    td.title { font-weight: 700; min-width: 11rem; }
    th:first-child, td:first-child { padding-left: 1.25rem; }
    th:last-child, td:last-child { padding-right: 1.25rem; }
    td input { padding: .4rem .6rem; }
    td.num input { width: 6.5rem; text-align: right; }
    .total { display: inline-block; background: var(--peach); border: var(--line); border-radius: 8px; padding: .15rem .6rem; font-weight: 900; }
    .empty { padding: 2.5rem 1rem; text-align: center; color: var(--muted); }

    footer {
      max-width: 1200px; margin: 0 auto; padding: 1.25rem 1.5rem 2rem;
      display: flex; justify-content: space-between; gap: .5rem 1.5rem; flex-wrap: wrap;
      border-top: 1.5px dashed var(--ink);
      color: #4b5162; font-size: .88rem;
    }

    .error { --shadow: var(--pink); max-width: 560px; padding: 1.75rem; display: grid; gap: .9rem; justify-items: start; }

    @media (max-width: 980px) {
      .workspace.with-side { grid-template-columns: 1fr; }
      .panel.side { position: static; order: -1; }
      .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }
    @media (max-width: 560px) {
      .topbar { position: static; }
      .topbar-inner, .shell, footer { padding-left: 1rem; padding-right: 1rem; }
      .account { width: 100%; }
      .account button { flex: 1; }
      h1 { font-size: 1.5rem; }
    }
    @media (prefers-reduced-motion: reduce) { .btn { transition: none; } }
  </style>
</head>
<body>
  <header class="topbar">
    <div class="topbar-inner">
      <a class="brand" href="/">
        <span class="brand-mark" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1d2330" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 6.5C10 5 7 4.5 4 5v13c3-.5 6 0 8 1.5 2-1.5 5-2 8-1.5V5c-3-.5-6 0-8 1.5Z"/><path d="M12 6.5v13"/></svg>
        </span>
        Quản lý Sách
      </a>
      <nav class="nav">
        <a href="/" aria-current="page">Sách</a>
        <a href="/status">/status</a>
      </nav>
      <form method="POST" action="/account" class="account" aria-label="Tài khoản">
        <button type="submit" name="account" value="reader" aria-pressed="{{#if isWriter}}false{{else}}true{{/if}}">
          Reader <small>{{readUser}} · chỉ xem</small>
        </button>
        <button type="submit" name="account" value="writer" aria-pressed="{{#if isWriter}}true{{else}}false{{/if}}">
          Writer <small>{{writeUser}} · Thủ Thư</small>
        </button>
      </form>
    </div>
  </header>
  <main class="shell">{{{body}}}</main>
  <footer>
    <span>{{studentName}} – MSSV: {{studentId}} – VAT áp dụng: {{vat}}%</span>
    <span>Số lần truy cập (session): {{views}}</span>
  </footer>
</body>
</html>
